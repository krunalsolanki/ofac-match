@page "/"
@using OfacMatch.Data
@using OfacMatch.Screening
@inject SanctionsData Data
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>OfacMatch – try OFAC name screening</PageTitle>

<header>
    <h1>OfacMatch</h1>
    <p class="tagline">Screen a name against the OFAC SDN sanctions list and see <em>why</em> it matched.</p>
    <p class="private">Runs entirely in your browser. The names you type are never sent anywhere.</p>
</header>

<main>
    <nav class="modes" aria-label="Screening mode">
        <button type="button" class="@(_batch ? "" : "active")" aria-pressed="@(!_batch)" @onclick="ShowOneName">One name</button>
        <button type="button" class="@(_batch ? "active" : "")" aria-pressed="@_batch" @onclick="ShowList">A list of names (CSV)</button>
    </nav>

    @if (!_batch)
    {
        <aside class="compare-callout" aria-label="Compare with your screening tool">
            <p>
                <strong>Already use a screening tool? Compare it in 10 minutes.</strong>
                A 25-name test from the public SDN list: 10 listed names spelled differently, 5 renamed companies
                that only a listed email, phone, website or crypto address can catch, and 10 ordinary names.
                See how OfacMatch scores, then run the same file through your tool.
            </p>
            <p class="examples">
                <button type="button" class="primary" @onclick="StartComparison">Run the test here</button>
                <button type="button" @onclick="DownloadComparisonAsync">Download the test file</button>
                <a href="@ComparisonTest.GuideUrl" target="_blank" rel="noopener">Answer key</a>
            </p>
        </aside>
    }

    @if (_batch)
    {
        <BatchPanel @key="_runComparison" RunComparison="_runComparison" />
    }
    else
    {
        <form class="search" @onsubmit="ScreenAsync" @onsubmit:preventDefault>
            <label class="name">
                Name
                <input @bind="_name" placeholder="e.g. Aymen Zawahri or DOE, John" maxlength="@ScreeningRequest.MaxNameLength" autofocus />
            </label>
            <label>
                Year of birth <span class="optional">optional</span>
                <input type="number" @bind="_yearOfBirth" placeholder="e.g. 1970" min="@ScreeningRequest.MinYearOfBirth" max="@DateTime.UtcNow.Year" />
            </label>
            <label>
                Country <span class="optional">optional</span>
                <input @bind="_country" placeholder="e.g. Egypt" maxlength="@ScreeningRequest.MaxCountryLength" />
            </label>
            <label>
                Type
                <select @bind="_type">
                    <option value="">All</option>
                    @foreach (var type in Enum.GetValues<EntryType>())
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </label>
            <label>
                Minimum score
                <input type="number" @bind="_minScore" min="0" max="100" step="1" />
            </label>
            <details class="more" open="@_moreOpen">
                <summary>More details <span class="optional">optional: email, phone, website, crypto address</span></summary>
                <p class="meta">
                    Also checks the email addresses, phone numbers, websites and crypto addresses that OFAC lists.
                    A name change doesn't hide these.
                </p>
                <div class="more-fields">
                    <label>
                        Email
                        <input type="email" @bind="_email" placeholder="e.g. sales@example.com" maxlength="@ScreeningRequest.MaxIdentifierLength" />
                    </label>
                    <label>
                        Phone
                        <input type="tel" @bind="_phone" placeholder="e.g. +86 158 0000 0000" maxlength="@ScreeningRequest.MaxIdentifierLength" />
                    </label>
                    <label>
                        Website
                        <input @bind="_website" placeholder="e.g. example.com" maxlength="@ScreeningRequest.MaxIdentifierLength" />
                    </label>
                    <label>
                        Crypto address
                        <input @bind="_crypto" placeholder="e.g. a Bitcoin or Ethereum address" maxlength="@ScreeningRequest.MaxIdentifierLength" />
                    </label>
                </div>
            </details>
            <button type="submit" disabled="@_busy">@(_busy ? "Screening…" : "Screen")</button>
        </form>

        <p class="examples">
            Try:
            <button type="button" @onclick='() => TryAsync("Aymen Zawahri", 1951)'>Aymen Zawahri, born 1951</button>
            <button type="button" @onclick='() => TryAsync("Aymen Zawahri", 1990)'>same name, born 1990</button>
            <button type="button" @onclick='() => TryAsync("John Smith", null)'>John Smith</button>
            <button type="button" @onclick='() => TryAsync("Brand New Precision LLC", null, "sales@yolimachine.com")'>a renamed company, by its email</button>
        </p>

        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }

        @if (_status is not null)
        {
            <p class="status" aria-live="polite">@_status</p>
        }

        @if (_matches is not null)
        {
            <h2>@ResultTitle</h2>
            @if (_matches.Count == 0)
            {
                <p class="clear">No listed name scored @_usedMinScore or higher@(_usedIdentifiers ? ", and none of the details you gave is listed" : "").</p>
            }

            @foreach (var match in _matches)
            {
                <article class="match">
                    @if (match.MatchedBy == MatchBasis.Identifier)
                    {
                        <div class="score identifier" title="Found by @BatchFile.MatchedBy(match).ToLowerInvariant(); the name scored @match.Score.ToString("0.0")">@BatchFile.MatchedBy(match)</div>
                    }
                    else
                    {
                        <div class="score @ScoreClass(match.Score)">@match.Score.ToString("0.0")</div>
                    }
                    <div class="detail">
                        <h3>@match.Entry.Name</h3>
                        <p class="meta">
                            Entry @match.Entry.Id · @match.Entry.Type · programs: @string.Join(", ", match.Entry.Programs)
                        </p>
                        @if (match.IdentifierMatches.Count > 0)
                        {
                            <div class="identifier-match">
                                <strong>@(match.MatchedBy == MatchBasis.Identifier ? "Found by a listed detail, not by the name." : "The name and a listed detail both match.")</strong>
                                <ul>
                                    @foreach (var id in match.IdentifierMatches)
                                    {
                                        <li>@id.Describe()</li>
                                    }
                                </ul>
                            </div>
                        }
                        <p>
                            @if (match.MatchedBy == MatchBasis.Identifier)
                            {
                                <text>Closest name: the @Kind(match.NameKind) <strong>“@match.MatchedName”</strong>, score @match.Score.ToString("0.0") (below @_usedMinScore). The party may be using another name.</text>
                            }
                            else
                            {
                                <text>Matched the @Kind(match.NameKind) <strong>“@match.MatchedName”</strong> using @Technique(match.NameScore.Technique).</text>
                            }
                        </p>

                        @if (match.DateOfBirthConflict)
                        {
                            <p class="conflict">Date of birth conflict: listed @string.Join(", ", match.Entry.DatesOfBirth). Likely a different person; review before clearing.</p>
                        }

                        @if (match.CountryConflict)
                        {
                            <p class="conflict">Country conflict: listed @string.Join(", ", match.Entry.Countries).</p>
                        }

                        @if (match.MatchedBy != MatchBasis.Identifier)
                        {
                            <table>
                                <thead>
                                    <tr><th>Your name part</th><th>Listed part</th><th>Similarity</th><th>Sounds alike</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var part in match.NameScore.Parts)
                                    {
                                        <tr>
                                            <td>@part.QueryPart</td>
                                            <td>@(part.ListedPart ?? "no match")</td>
                                            <td>@part.Similarity.ToString("0.000")</td>
                                            <td>@(part.SoundsAlike ? "yes" : "no")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <p class="meta">
                                Whole-name score @match.NameScore.FullNameScore.ToString("0.0")@(match.NameScore.FullNameCounts ? "" : " (not counted: a name part has no close partner)");
                                name-parts score @match.NameScore.NamePartsScore.ToString("0.0").
                            </p>
                        }
                    </div>
                </article>
            }
        }
    }

    <section class="notice">
        <p>
            Potential matches only. A score measures how alike two names are written, not whether they are the same party.
            A person must review each match against the full record before any decision. Not legal advice.
        </p>
        @if (Data.Entries > 0)
        {
            <p>
                List: @Data.Entries.ToString("N0") entries and @Data.Aliases.ToString("N0") aliases from OFAC@(Data.DownloadedUtc is { } at ? $", downloaded {at:yyyy-MM-dd HH:mm} UTC" : "").
            </p>
        }
    </section>

    <section class="install">
        <h2>Use it in your own code or AI assistant</h2>
        <p>.NET library:</p>
        <pre>dotnet add package OfacMatch</pre>
        <p>MCP server for Claude, VS Code and Visual Studio:</p>
        <pre>claude mcp add ofac-match -- dnx OfacMatch.Mcp --yes</pre>
        <p>Or try the MCP server without installing: <a href="https://glama.ai/mcp/servers/krunalsolanki/ofac-match">open it on Glama</a> and click "Try in Browser" (test names only: what you type there goes to Glama).</p>
        <p><a href="https://github.com/krunalsolanki/ofac-match">Source, docs and evaluation on GitHub</a> · Built by Krunal Solanki</p>
        <FeedbackLinks />
    </section>
</main>

@code {
    private bool _batch;
    private bool _runComparison;

    // Each mode has its own address (?mode=list, ?test=compare), so the browser's Back and
    // Forward buttons move between them and each can be shared as a link.
    private void ShowOneName() => Navigation.NavigateTo("./");

    private void ShowList() => Navigation.NavigateTo("./?mode=list");

    private void StartComparison() => Navigation.NavigateTo("./?test=compare");

    private async Task DownloadComparisonAsync() =>
        await JS.InvokeVoidAsync("ofacMatchDownload", ComparisonTest.FileName, ComparisonTest.Csv);

    // ?test=compare opens the list mode and runs the 25-name comparison test straight away;
    // ?mode=list opens the list mode.
    protected override void OnInitialized()
    {
        ApplyAddress(Navigation.Uri);
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        ApplyAddress(e.Location);
        StateHasChanged();
    }

    private void ApplyAddress(string address)
    {
        var query = new Uri(address).Query;
        _runComparison = query.Contains("test=compare", StringComparison.OrdinalIgnoreCase);
        _batch = _runComparison || query.Contains("mode=list", StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private string _name = "";
    private int? _yearOfBirth;
    private string _country = "";
    private string _type = "";
    private string _email = "";
    private string _phone = "";
    private string _website = "";
    private string _crypto = "";
    private bool _moreOpen;
    private bool _usedIdentifiers;
    private double _minScore = 85;
    private double _usedMinScore;
    private bool _busy;
    private string? _status;
    private string? _error;
    private string? _screenedName;
    private IReadOnlyList<ScreeningMatch>? _matches;

    private string ResultTitle => _matches!.Count == 1
        ? $"1 potential match for “{_screenedName}”"
        : $"{_matches.Count} potential matches for “{_screenedName}”";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Start loading the list right away, so it is usually ready by the time a name is typed.
        _status = "Loading the OFAC list (first visit only)…";
        StateHasChanged();
        await Task.Delay(1);
        try
        {
            await Data.GetAsync();
            _status = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidDataException)
        {
            _status = null;
            _error = "Couldn't load the OFAC list. Reload the page to try again.";
        }

        StateHasChanged();
    }

    private async Task TryAsync(string name, int? yearOfBirth, string email = "")
    {
        _name = name;
        _yearOfBirth = yearOfBirth;
        _email = email;
        _phone = _website = _crypto = "";
        _moreOpen = email.Length > 0;
        _country = "";
        _type = "";
        _minScore = 85;
        await ScreenAsync();
    }

    private async Task ScreenAsync()
    {
        _error = null;
        _matches = null;

        ScreeningRequest request;
        try
        {
            // The library's own validation gives the messages, e.g. a blank name or a year out of range.
            request = new ScreeningRequest(_name)
            {
                YearOfBirth = _yearOfBirth,
                Country = string.IsNullOrWhiteSpace(_country) ? null : _country.Trim(),
                Type = Enum.TryParse<EntryType>(_type, out var type) ? type : null,
                MinScore = _minScore,
                Email = _email,
                Phone = _phone,
                Website = _website,
                CryptoAddress = _crypto,
            };
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message.Split('\n')[0].Replace($" (Parameter '{ex.ParamName}')", "");
            return;
        }

        _busy = true;
        try
        {
            if (Data.Entries == 0)
            {
                _status = "Loading the OFAC list (about 8 MB, first time only)…";
                StateHasChanged();
                await Task.Delay(1); // let the status render before the work starts
            }

            var screener = await Data.GetAsync();
            _status = null;
            _matches = screener.Screen(request);
            _screenedName = request.Name;
            _usedMinScore = _minScore;
            _usedIdentifiers = request.Email is not null || request.Phone is not null || request.Website is not null || request.CryptoAddress is not null;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidDataException)
        {
            _status = null;
            _error = "Couldn't load the OFAC list. Reload the page to try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private static string ScoreClass(double score) => score >= 95 ? "high" : score >= 90 ? "medium" : "low";

    private static string Technique(OfacMatch.Matching.MatchTechnique technique) =>
        technique == OfacMatch.Matching.MatchTechnique.NameParts ? "name-part matching" : "whole-name matching";

    private static string Kind(NameKind kind) => kind switch
    {
        NameKind.Primary => "primary name",
        NameKind.Aka => "alias (also known as)",
        NameKind.Fka => "former name",
        _ => "new name",
    };
}
