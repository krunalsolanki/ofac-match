<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <RootNamespace>OfacMatch</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>OfacMatch</PackageId>
    <Version>0.1.2</Version>
    <Authors>Krunal Solanki</Authors>
    <Description>Explainable OFAC sanctions name screening for .NET. Loads the official SDN list, scores names on OFAC's 0-100 scale using Jaro-Winkler and Soundex, and explains every match. Zero dependencies; runs on .NET Framework 4.7.2+ (tested on 4.8) and modern .NET.</Description>
    <PackageTags>ofac;sdn;sanctions;screening;aml;kyc;compliance;fuzzy-matching;jaro-winkler;soundex</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/krunalsolanki/ofac-match</PackageProjectUrl>
    <RepositoryUrl>https://github.com/krunalsolanki/ofac-match</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="OfacMatch.Tests" />
  </ItemGroup>

</Project>
